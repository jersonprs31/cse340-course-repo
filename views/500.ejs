<%- include('partials/header') %>
<main>
    <h1>500 - Server Error</h1>
    <p>Oops! Something went wrong on our server while trying to process your request.</p>
    
    <!-- This will print the actual technical error to the screen to help you debug -->
    <% if (typeof message !== 'undefined') { %>
        <div style="background-color: #f8d7da; color: #721c24; padding: 15px; border: 1px solid #f5c6cb; margin-top: 20px;">
            <strong>Error Details:</strong> <%= message %>
        </div>
    <% } %>
</main>
<%- include('partials/footer') %>