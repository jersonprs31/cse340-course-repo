<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        
        <!-- Edit Button/Link -->
        <p style="margin-top: -10px; margin-bottom: 20px;">
            <a href="/edit-category/<%= category.category_id %>" style="font-weight: bold; color: #0056b3; text-decoration: none;">[ Edit Category ]</a>
        </p>

        <p>Service projects in this category:</p>
       
        <% if (locals.projects && projects.length > 0) { %>
            <ul>
                <% projects.forEach(project => { %>
                    <li style="margin-bottom: 10px;">
                        <strong><a href="/project/<%= project.project_id %>"><%= project.title %></a></strong>
                        <br>
                        Host: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>No upcoming projects available in this category.</p>
        <% } %>
    </main>
<%- include('partials/footer') %>