<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <% if (locals.error) { %>
        <p style="color: red; font-weight: bold;"><%= error %></p>
    <% } %>

    <form action="/login" method="POST">
        <div class="form-group" style="margin-bottom: 15px;">
            <label for="email" style="display: block; margin-bottom: 5px;">Email (Username)</label>
            <input type="email" id="email" name="email" required style="width: 100%; padding: 8px; box-sizing: border-box;" />
        </div>
        
        <div class="form-group" style="margin-bottom: 15px;">
            <label for="password" style="display: block; margin-bottom: 5px;">Password</label>
            <input type="password" id="password" name="password" required style="width: 100%; padding: 8px; box-sizing: border-box;" />
        </div>
        
        <button type="submit" style="padding: 10px 15px; background-color: #0056b3; color: white; border: none; cursor: pointer;">Login</button>
    </form>
</main>   
<%- include('partials/footer') %>