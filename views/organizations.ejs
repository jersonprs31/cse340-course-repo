<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <div style="margin-bottom: 20px;">
        <a href="/new-organization" style="padding: 10px 15px; background-color: #0056b3; color: white; text-decoration: none; border-radius: 5px; display: inline-block;">+ Create New Organization</a>
    </div>

    <% if (organizations && organizations.length > 0) { %>
        <ul style="list-style-type: none; padding: 0;">
            <% organizations.forEach(org => { %>
                <li style="margin-bottom: 10px;">
                    <a href="/organization/<%= org.organization_id %>" style="color: purple; text-decoration: underline; font-size: 1.1em;"><%= org.name %></a>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No organizations found.</p>
    <% } %>
</main>
<%- include('partials/footer') %>